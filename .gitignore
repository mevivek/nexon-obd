# Vehicle data — these contain the VIN (mode 09 0902, UDS 22 F190 / 22 F1A0).
# Keep them off GitHub.
*.csv
obd_log.csv
did_hits.csv
ecm_did_hits.csv

# hardware/ carries board design data, not vehicle data, so three files are let
# back in — BY NAME, never as hardware/*.csv. A glob there would silently admit
# anything later dropped in that directory, including a scan dump with a VIN in
# it, which is the exact thing the rule above exists to stop. Adding a fourth
# design CSV means adding a fourth line here, deliberately.
!hardware/netlist.csv
!hardware/bom.csv
!hardware/placement.csv
!hardware/xiao-pinmap.csv

# Build output
build/
*.bin
*.elf
*.map

# hardware/ render and 3D export output. Regenerated in a second or two by
# kicad-cli from the committed .kicad_pcb - see hardware/README.md. No reason to
# carry megabytes of binary that a command reproduces.
*.glb
*.step
*.stl
hardware/*.png
hardware/gerbers/

# KiCad local UI state and backups. The .kicad_pro (netclasses, DRC rules) and
# the .kicad_pcb are committed; these are per-machine noise.
*.kicad_prl
*-backups/

# Host test artefacts (regenerated by firmware/test/run.sh)
firmware/test/isotp_extract.h
firmware/test/didmap_extract.h
firmware/test/isotp_test

# Toolchain / editor
tools/arduino-cli.exe
.vscode/
.idea/
Thumbs.db
desktop.ini

# Local toolchain installed by firmware/build.sh
firmware/.toolchain/

# Python bytecode, created when the test tooling imports extract.py
__pycache__/
*.pyc
*.exe
